# Copy to .env and fill in. The :?-guarded values are REQUIRED — compose
# refuses to start without them, on purpose.

# Required. Postgres password for the compose-internal database (owner role).
POSTGRES_PASSWORD=

# Required. Password for the SELECT-only mcp_readonly role the agent's DB
# tool connects as — distinct from the owner password by design.
MCP_READONLY_PASSWORD=

# Required. Signs demo-session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

DEMO_TOKEN_TTL=2h

# Ollama on the VPS, outside Docker. NOTE: tool calling needs llama3.1 or
# newer — plain llama3:8b does not reliably emit tool calls. Pull it with:
#   ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Ceiling on reasoning iterations per question.
AGENT_MAX_STEPS=6
MAX_QUESTION_CHARS=1000

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=10
