# Copy to .env and adjust for this VPS. Everything here has a sane default
# baked into docker-compose.yml; nothing in this file is a secret any more,
# because this service no longer signs tokens — it only verifies them.

# Required. Postgres password for the compose-internal database (owner role).
POSTGRES_PASSWORD=

# Required. Password for the SELECT-only mcp_readonly role the agent's DB
# tool connects as — distinct from the owner password by design.
MCP_READONLY_PASSWORD=

# Identity. This service no longer signs anything — it verifies tokens issued
# by id.build-with-deepak.com against that service's published JWKS, so there
# is deliberately no secret here to leak. See apps/api/src/auth/jwt-auth.guard.ts.
IDENTITY_ISSUER=https://id.build-with-deepak.com
IDENTITY_JWKS_URL=https://id.build-with-deepak.com/.well-known/jwks.json
IDENTITY_AUDIENCE=agent.build-with-deepak.com

# Ollama on the VPS, outside Docker. NOTE: tool calling needs llama3.1 or
# newer — plain llama3:8b does not reliably emit tool calls. Pull it with:
#   ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Ceiling on reasoning iterations per question.
AGENT_MAX_STEPS=6
MAX_QUESTION_CHARS=1000

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=10
